rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'alangambacorta7@gmail.com';
    }

    match /repuestos/{userId}/{seccion}/{archivo} {

      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 200 * 1024
        && seccion in ['maquinas', 'cubierta', 'puente']
        && seccion == firestore.get(
            /databases/(default)/documents/usuarios/$(userId)/config/perfil
          ).data.sector;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Portadas de noticias: lectura para logueados, escritura solo admin.
    match /noticias/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
