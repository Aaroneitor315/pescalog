rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'alangambacorta7@gmail.com';
    }

    // Fotos de repuestos: cada usuario lee/escribe lo suyo; admin lee todo.
    match /repuestos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Portadas de noticias: lectura para logueados, escritura solo admin.
    match /noticias/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
